{
  "contract_version": "1.0.0",
  "envelope": {
    "additionalProperties": false,
    "description": "One SSE frame: `id: <seq>`, `event: <event>`, `data: <json of data>`.",
    "properties": {
      "data": {
        "additionalProperties": true,
        "title": "Data",
        "type": "object"
      },
      "event": {
        "title": "Event",
        "type": "string"
      },
      "seq": {
        "title": "Seq",
        "type": "integer"
      }
    },
    "required": [
      "seq",
      "event",
      "data"
    ],
    "title": "EventEnvelope",
    "type": "object"
  },
  "job_events": {
    "job_done": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "result"
      ],
      "title": "JobDone",
      "type": "object"
    },
    "job_error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "job_progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "title": "Done",
          "type": "integer"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "job_id",
        "done",
        "total"
      ],
      "title": "JobProgress",
      "type": "object"
    }
  },
  "run_events": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "final": {
      "$defs": {
        "Cluster": {
          "additionalProperties": false,
          "properties": {
            "category": {
              "title": "Category",
              "type": "string"
            },
            "claim": {
              "title": "Claim",
              "type": "string"
            },
            "evidence": {
              "default": "",
              "title": "Evidence",
              "type": "string"
            },
            "file": {
              "default": "",
              "title": "File",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "kind": {
              "enum": [
                "finding",
                "verdict"
              ],
              "title": "Kind",
              "type": "string"
            },
            "line_end": {
              "default": 0,
              "title": "Line End",
              "type": "integer"
            },
            "line_start": {
              "default": 0,
              "title": "Line Start",
              "type": "integer"
            },
            "severity": {
              "default": "medium",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "title": "Severity",
              "type": "string"
            },
            "support_share": {
              "description": "supporters' weight / total_weight",
              "maximum": 1,
              "minimum": 0,
              "title": "Support Share",
              "type": "number"
            },
            "supporters": {
              "items": {
                "$ref": "#/$defs/Supporter"
              },
              "title": "Supporters",
              "type": "array"
            },
            "tool_verified": {
              "default": false,
              "title": "Tool Verified",
              "type": "boolean"
            },
            "total_weight": {
              "description": "Sum of the weights of all answering debaters",
              "title": "Total Weight",
              "type": "number"
            },
            "verdict": {
              "anyOf": [
                {
                  "enum": [
                    "issue",
                    "no_issue",
                    "true",
                    "false",
                    "unsure"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Set when kind is 'verdict'",
              "title": "Verdict"
            },
            "vote_accept": {
              "description": "Weighted vote outcome, before the judge",
              "title": "Vote Accept",
              "type": "boolean"
            },
            "weighted_score": {
              "description": "sum(weight * confidence) over supporters",
              "title": "Weighted Score",
              "type": "number"
            }
          },
          "required": [
            "id",
            "kind",
            "category",
            "claim",
            "supporters",
            "weighted_score",
            "total_weight",
            "support_share",
            "vote_accept"
          ],
          "title": "Cluster",
          "type": "object"
        },
        "Dissent": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "title": "Alias",
              "type": "string"
            },
            "confidence": {
              "title": "Confidence",
              "type": "number"
            },
            "finding_ids": {
              "items": {
                "type": "string"
              },
              "title": "Finding Ids",
              "type": "array"
            },
            "model_id": {
              "title": "Model Id",
              "type": "string"
            },
            "reason": {
              "default": "",
              "title": "Reason",
              "type": "string"
            },
            "verdict": {
              "enum": [
                "issue",
                "no_issue",
                "true",
                "false",
                "unsure"
              ],
              "title": "Verdict",
              "type": "string"
            }
          },
          "required": [
            "model_id",
            "alias",
            "verdict",
            "confidence"
          ],
          "title": "Dissent",
          "type": "object"
        },
        "FinalVerdict": {
          "additionalProperties": false,
          "properties": {
            "overall": {
              "enum": [
                "issue",
                "no_issue",
                "true",
                "false",
                "unsure"
              ],
              "title": "Overall",
              "type": "string"
            },
            "summary": {
              "title": "Summary",
              "type": "string"
            }
          },
          "required": [
            "overall",
            "summary"
          ],
          "title": "FinalVerdict",
          "type": "object"
