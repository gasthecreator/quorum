{
  "contract_version": "1.2.0",
  "envelope": {
    "additionalProperties": false,
    "description": "One SSE frame: `id: <seq>`, `event: <event>`, `data: <json of data>`.",
    "properties": {
      "data": {
        "additionalProperties": true,
        "title": "Data",
        "type": "object"
      },
      "event": {
        "title": "Event",
        "type": "string"
      },
      "seq": {
        "title": "Seq",
        "type": "integer"
      }
    },
    "required": [
      "seq",
      "event",
      "data"
    ],
    "title": "EventEnvelope",
    "type": "object"
  },
  "job_events": {
    "job_done": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "result"
      ],
      "title": "JobDone",
      "type": "object"
    },
    "job_error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "job_progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "title": "Done",
          "type": "integer"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "job_id",
        "done",
        "total"
      ],
      "title": "JobProgress",
      "type": "object"
    }
  },
  "run_events": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "escalated": {
      "additionalProperties": false,
      "properties": {
        "added_model_ids": {
          "items": {
            "type": "string"
          },
          "title": "Added Model Ids",
          "type": "array"
        },
        "agreement": {
          "title": "Agreement",
          "type": "number"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "first_pass_model_ids": {
          "items": {
            "type": "string"
          },
          "title": "First Pass Model Ids",
          "type": "array"
        },
        "reason": {
          "enum": [
            "disagreement",
            "low_confidence"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "detail",
        "first_pass_model_ids",
        "added_model_ids",
        "agreement"
      ],
      "title": "Escalated",
      "type": "object"
    },
    "final": {
      "$defs": {
        "Agreement": {
          "additionalProperties": false,
          "description": "A cluster every answering panelist backed.",
          "properties": {
            "aliases": {
              "items": {
                "type": "string"
              },
              "title": "Aliases",
              "type": "array"
            },
            "claim": {
              "title": "Claim",
              "type": "string"
            },
            "cluster_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "None when the panel agreed there is nothing to flag",
              "title": "Cluster Id"
            }
          },
          "required": [
            "claim",
            "aliases"
          ],
          "title": "Agreement",
          "type": "object"
        },
        "BlindSpot": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "title": "Alias",
              "type": "string"
            },
            "kind": {
              "enum": [
                "biggest_blind_spot",
                "missed_by_all"
              ],
              "title": "Kind",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "alias",
            "kind",
            "text"
          ],
          "title": "BlindSpot",
          "type": "object"
        },
        "Clash": {
          "additionalProperties": false,
          "description": "A cluster the panel split on. Both sides are shown.",
          "properties": {
            "against_side": {
              "$ref": "#/$defs/ClashSide"
            },
            "claim": {
              "title": "Claim",
              "type": "string"
            },
            "cluster_id": {
              "title": "Cluster Id",
              "type": "string"
            },
            "for_side": {
              "$ref": "#/$defs/ClashSide"
            }
          },
          "required": [
            "cluster_id",
            "claim",
            "for_side",
            "against_side"
          ],
          "title": "Clash",
          "type": "object"
        },
        "ClashSide": {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "items": {
                "type": "string"
              },
              "title": "Aliases",
              "type": "array"
            },
            "argument": {
              "default": "",
              "title": "Argument",
              "type": "string"
            }
          },
          "required": [
            "aliases"
          ],
          "title": "ClashSide",
          "type": "object"
        },
        "Cluster": {
          "additionalProperties": false,
          "properties": {
            "category": {
              "title": "Category",
              "type": "string"
            },
            "claim": {
              "title": "Claim",
              "type": "string"
            },
            "evidence": {
              "default": "",
              "title": "Evidence",
              "type": "string"
            },
            "file": {
              "default": "",
              "title": "File",
              "type": "string"
            },
            "fix": {
              "default": "",
              "title": "Fix",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "kind": {
              "enum": [
                "finding",
                "verdict"
              ],
              "title": "Kind",
              "type": "string"
            },
            "line_end": {
              "default": 0,
              "title": "Line End",
              "type": "integer"
            },
            "line_start": {
              "default": 0,
              "title": "Line Start",
              "type": "integer"
            },
            "severity": {
              "default": "medium",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "title": "Severity",
              "type": "string"
            },
            "support_share": {
              "description": "supporters' weight / total_weight",
              "maximum": 1,
              "minimum": 0,
              "title": "Support Share",
              "type": "number"
            },
            "supporters": {
              "items": {
                "$ref": "#/$defs/Supporter"
              },
              "title": "Supporters",
              "type": "array"
            },
            "tool_rule": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Tool Rule"
            },
            "tool_verified": {
              "default": false,
              "description": "A static-analysis tool confirmed it. Such a cluster is always accepted, and the judge cannot reject it. May have no supporters (the tool found what no model did).",
              "title": "Tool Verified",
              "type": "boolean"
            },
            "total_weight": {
              "description": "Sum of the weights of all answering debaters",
              "title": "Total Weight",
              "type": "number"
            },
            "verdict": {
              "anyOf": [
                {
                  "enum": [
                    "issue",
                    "no_issue",
                    "true",
                    "false",
                    "unsure"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Set when kind is 'verdict'",
              "title": "Verdict"
            },
            "vote_accept": {
              "description": "Weighted vote outcome, before the judge",
              "title": "Vote Accept",
              "type": "boolean"
            },
            "weighted_score": {
              "description": "sum(weight * confidence) over supporters",
              "title": "Weighted Score",
              "type": "number"
            }
          },
          "required": [
            "id",
            "kind",
            "category",
            "claim",
            "supporters",
            "weighted_score",
            "total_weight",
            "support_share",
            "vote_accept"
          ],
          "title": "Cluster",
          "type": "object"
        },
        "Dissent": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "title": "Alias",
              "type": "string"
            },
            "confidence": {
              "title": "Confidence",
              "type": "number"
            },
            "finding_ids": {
              "items": {
                "type": "string"
              },
              "title": "Finding Ids",
              "type": "array"
            },
            "model_id": {
              "title": "Model Id",
              "type": "string"
            },
            "reason": {
              "default": "",
              "title": "Reason",
              "type": "string"
            },
            "verdict": {
              "enum": [
                "issue",
                "no_issue",
                "true",
                "false",
                "unsure"
              ],
              "title": "Verdict",
              "type": "string"
            }
          },
          "required": [
            "model_id",
            "alias",
            "verdict",
            "confidence"
          ],
          "title": "Dissent",
          "type": "object"
        },
        "FinalVerdict": {
          "additionalProperties": false,
          "properties": {
            "overall": {
              "enum": [
                "issue",
                "no_issue",
                "true",
                "false",
                "unsure"
              ],
              "title": "Overall",
              "type": "string"
            },
            "summary": {
              "title": "Summary",
              "type": "string"
            }
          },
          "required": [
            "overall",
            "summary"
          ],
          "title": "FinalVerdict",
          "type": "object"
        },
        "NextStep": {
          "additionalProperties": false,
          "properties": {
            "cluster_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cluster Id"
            },
            "patch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Suggested replacement code, when a panelist gave one",
              "title": "Patch"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "title": "NextStep",
          "type": "object"
        },
        "Recommendation": {
          "additionalProperties": false,
          "properties": {
            "confidence": {
              "description": "weight x confidence of panelists who agree with the verdict / total weight",
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "text": {
              "title": "Text",
              "type": "string"
            },
            "tool_verified": {
              "default": false,
              "description": "A static-analysis tool confirmed at least one finding behind this verdict. Confidence still reflects the panel only, so it can be low or 0",
              "title": "Tool Verified",
              "type": "boolean"
            },
            "verdict": {
              "enum": [
                "issue",
                "no_issue",
                "true",
                "false",
                "unsure"
              ],
              "title": "Verdict",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "text",
            "confidence"
          ],
          "title": "Recommendation",
          "type": "object"
        },
        "Supporter": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "title": "Alias",
              "type": "string"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "finding_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Finding Id"
            },
            "model_id": {
              "title": "Model Id",
              "type": "string"
            },
            "weight": {
              "maximum": 1,
              "minimum": 0,
              "title": "Weight",
              "type": "number"
            },
            "weight_source": {
              "enum": [
                "measured",
                "pooled",
                "default"
              ],
              "title": "Weight Source",
              "type": "string"
            }
          },
          "required": [
            "model_id",
            "alias",
            "confidence",
            "weight",
            "weight_source"
          ],
          "title": "Supporter",
          "type": "object"
        },
        "Usage": {
          "additionalProperties": false,
          "properties": {
            "calls": {
              "default": 0,
              "title": "Calls",
              "type": "integer"
            },
            "completion_tokens": {
              "default": 0,
              "title": "Completion Tokens",
              "type": "integer"
            },
            "elapsed_ms": {
              "default": 0,
              "title": "Elapsed Ms",
              "type": "integer"
            },
            "prompt_tokens": {
              "default": 0,
              "title": "Prompt Tokens",
              "type": "integer"
            }
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "agreements": {
          "items": {
            "$ref": "#/$defs/Agreement"
          },
          "title": "Agreements",
          "type": "array"
        },
        "blind_spots": {
          "items": {
            "$ref": "#/$defs/BlindSpot"
          },
          "title": "Blind Spots",
          "type": "array"
        },
        "clashes": {
          "items": {
            "$ref": "#/$defs/Clash"
          },
          "title": "Clashes",
          "type": "array"
        },
        "confirmed_findings": {
          "items": {
            "$ref": "#/$defs/Cluster"
          },
          "title": "Confirmed Findings",
          "type": "array"
        },
        "disputed_findings": {
          "items": {
            "$ref": "#/$defs/Cluster"
          },
          "title": "Disputed Findings",
          "type": "array"
        },
        "dissent": {
          "items": {
            "$ref": "#/$defs/Dissent"
          },
          "title": "Dissent",
          "type": "array"
        },
        "next_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "verdict": {
          "$ref": "#/$defs/FinalVerdict"
        }
      },
      "required": [
        "run_id",
        "verdict",
        "confirmed_findings",
        "disputed_findings",
        "dissent",
        "agreements",
        "clashes",
        "blind_spots",
        "recommendation",
        "usage"
      ],
      "title": "Final",
      "type": "object"
    },
    "finished_early": {
      "additionalProperties": false,
      "properties": {
        "agreement": {
          "title": "Agreement",
          "type": "number"
        },
        "calls_saved": {
          "description": "Lower bound: one blind call per model not consulted, plus the judge",
          "title": "Calls Saved",
          "type": "integer"
        },
        "min_confidence": {
          "title": "Min Confidence",
          "type": "number"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "title": "Model Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "model_ids",
        "agreement",
        "min_confidence",
        "calls_saved"
      ],
      "title": "FinishedEarly",
      "type": "object"
    },
    "framed": {
      "additionalProperties": false,
      "description": "A neutral restatement of the input, produced before round 0 so a leading prompt cannot steer\nevery model the same way. Debaters see it next to the original, never instead of it.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "input_flags": {
          "items": {
            "type": "string"
          },
          "title": "Input Flags",
          "type": "array"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "restatement": {
          "title": "Restatement",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "restatement"
      ],
      "title": "Framed",
      "type": "object"
    },
    "grounded": {
      "$defs": {
        "ToolFinding": {
          "additionalProperties": false,
          "description": "What a static-analysis tool reported. Line numbers are lines of the pasted input.",
          "properties": {
            "category": {
              "title": "Category",
              "type": "string"
            },
            "claim": {
              "title": "Claim",
              "type": "string"
            },
            "file": {
              "default": "",
              "title": "File",
              "type": "string"
            },
            "line_end": {
              "minimum": 0,
              "title": "Line End",
              "type": "integer"
            },
            "line_start": {
              "minimum": 0,
              "title": "Line Start",
              "type": "integer"
            },
            "rule_id": {
              "title": "Rule Id",
              "type": "string"
            },
            "tool": {
              "title": "Tool",
              "type": "string"
            }
          },
          "required": [
            "tool",
            "rule_id",
            "category",
            "line_start",
            "line_end",
            "claim"
          ],
          "title": "ToolFinding",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Static-analysis results, sent after the debate stops and before `tally`. Only when ground=true.",
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ToolFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "available",
        "findings"
      ],
      "title": "Grounded",
      "type": "object"
    },
    "judge_ruling": {
      "$defs": {
        "ClusterRuling": {
          "additionalProperties": false,
          "properties": {
            "accept": {
              "title": "Accept",
              "type": "boolean"
            },
            "cluster_id": {
              "title": "Cluster Id",
              "type": "string"
            },
            "overrides_vote": {
              "title": "Overrides Vote",
              "type": "boolean"
            },
            "reason": {
              "default": "",
              "title": "Reason",
              "type": "string"
            },
            "vote_accept": {
              "title": "Vote Accept",
              "type": "boolean"
            }
          },
          "required": [
            "cluster_id",
            "accept",
            "vote_accept",
            "overrides_vote"
          ],
          "title": "ClusterRuling",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "injection_flags": {
          "items": {
            "type": "string"
          },
          "title": "Injection Flags",
          "type": "array"
        },
        "judge_model_id": {
          "title": "Judge Model Id",
          "type": "string"
        },
        "overrides_vote": {
          "title": "Overrides Vote",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "recommendation": {
          "default": "",
          "description": "The judge's one-sentence recommendation, if given",
          "title": "Recommendation",
          "type": "string"
        },
        "rulings": {
          "items": {
            "$ref": "#/$defs/ClusterRuling"
          },
          "title": "Rulings",
          "type": "array"
        },
        "skipped": {
          "default": false,
          "description": "True when the early-finish path skipped the judge",
          "title": "Skipped",
          "type": "boolean"
        }
      },
      "required": [
        "judge_model_id",
        "rulings",
        "overrides_vote",
        "reason"
      ],
      "title": "JudgeRuling",
      "type": "object"
    },
    "model_message": {
      "$defs": {
        "Critique": {
          "additionalProperties": false,
          "description": "Rounds 1 and 2: a structured critique of the other panelists' latest answers.",
          "properties": {
            "biggest_blind_spot": {
              "default": "",
              "maxLength": 500,
              "title": "Biggest Blind Spot",
              "type": "string"
            },
            "missed_by_all": {
              "default": "",
              "description": "What did everyone miss",
              "maxLength": 500,
              "title": "Missed By All",
              "type": "string"
            },
            "strongest": {
              "default": "",
              "description": "Which message is strongest, and why",
              "maxLength": 500,
              "title": "Strongest",
              "type": "string"
            }
          },
          "title": "Critique",
          "type": "object"
        },
        "Finding": {
          "additionalProperties": false,
          "properties": {
            "category": {
              "maxLength": 64,
              "title": "Category",
              "type": "string"
            },
            "claim": {
              "maxLength": 600,
              "title": "Claim",
              "type": "string"
            },
            "evidence": {
              "default": "",
              "maxLength": 1200,
              "title": "Evidence",
              "type": "string"
            },
            "file": {
              "default": "",
              "maxLength": 256,
              "title": "File",
              "type": "string"
            },
