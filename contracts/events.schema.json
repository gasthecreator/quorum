        "Supporter": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "title": "Alias",
              "type": "string"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "finding_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Finding Id"
            },
            "model_id": {
              "title": "Model Id",
              "type": "string"
            },
            "weight": {
              "maximum": 1,
              "minimum": 0,
              "title": "Weight",
              "type": "number"
            },
            "weight_source": {
              "enum": [
                "measured",
                "pooled",
                "default"
              ],
              "title": "Weight Source",
              "type": "string"
            }
          },
          "required": [
            "model_id",
            "alias",
            "confidence",
            "weight",
            "weight_source"
          ],
          "title": "Supporter",
          "type": "object"
        },
        "Usage": {
          "additionalProperties": false,
          "properties": {
            "calls": {
              "default": 0,
              "title": "Calls",
              "type": "integer"
            },
            "completion_tokens": {
              "default": 0,
              "title": "Completion Tokens",
              "type": "integer"
            },
            "elapsed_ms": {
              "default": 0,
              "title": "Elapsed Ms",
              "type": "integer"
            },
            "prompt_tokens": {
              "default": 0,
              "title": "Prompt Tokens",
              "type": "integer"
            }
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "confirmed_findings": {
          "items": {
            "$ref": "#/$defs/Cluster"
          },
          "title": "Confirmed Findings",
          "type": "array"
        },
        "disputed_findings": {
          "items": {
            "$ref": "#/$defs/Cluster"
          },
          "title": "Disputed Findings",
          "type": "array"
        },
        "dissent": {
          "items": {
            "$ref": "#/$defs/Dissent"
          },
          "title": "Dissent",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "verdict": {
          "$ref": "#/$defs/FinalVerdict"
        }
      },
      "required": [
        "run_id",
        "verdict",
        "confirmed_findings",
        "disputed_findings",
        "dissent",
        "usage"
      ],
      "title": "Final",
      "type": "object"
    },
    "judge_ruling": {
      "$defs": {
        "ClusterRuling": {
          "additionalProperties": false,
          "properties": {
            "accept": {
              "title": "Accept",
