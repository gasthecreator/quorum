          "default": null,
          "title": "Error"
        },
        "injection_flags": {
          "items": {
            "type": "string"
          },
          "title": "Injection Flags",
          "type": "array"
        },
        "judge_model_id": {
          "title": "Judge Model Id",
          "type": "string"
        },
        "overrides_vote": {
          "title": "Overrides Vote",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rulings": {
          "items": {
            "$ref": "#/$defs/ClusterRuling"
